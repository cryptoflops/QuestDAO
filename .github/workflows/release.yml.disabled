name: Release

on:
  push:
    branches: [main]

permissions:
  contents: write
  pull-requests: write

jobs:
  release-please:
    runs-on: ubuntu-latest
    steps:
      - uses: googleapis/release-please-action@v4
        with:
          # simple: monorepo root has no publishable build (SDK is a separate
          # repo), so only cut GitHub tag/changelog releases here.
          release-type: simple
